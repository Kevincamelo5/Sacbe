[sub_resource type="GDScript" id="GDScript_db4q2"]
script/source = "extends CanvasLayer

# Ajusta las rutas según los nombres exactos de tus nodos en la escena
@onready var fondo_oscuro: ColorRect = $ColorRect if has_node(\"ColorRect\") else null
@onready var panel_contenedor: PanelContainer = $ColorRect/PanelContainer if has_node(\"ColorRect/PanelContainer\") else null
@onready var boton_continuar: Button = $ColorRect/PanelContainer/VBoxContainer/continuar if has_node(\"ColorRect/PanelContainer/VBoxContainer/continuar\") else $Continuar
@onready var boton_reiniciar: Button = $ColorRect/PanelContainer/VBoxContainer/reinciar if has_node(\"ColorRect/PanelContainer/VBoxContainer/reinciar\") else $Reiniciar
@onready var boton_salir: Button = $\"ColorRect/PanelContainer/VBoxContainer/guardar y salir\" if has_node(\"ColorRect/PanelContainer/VBoxContainer/guardar y salir\") else $RegresarMenuPrincipal

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_aplicar_estilo_pausa()

func _aplicar_estilo_pausa() -> void:
	# 1. Ajustar el fondo opaco/selva
	if fondo_oscuro:
		fondo_oscuro.color = Color(0.04, 0.08, 0.05, 0.75) # Verde selva muy oscuro y transparente

	# 2. Estilo para el panel central (Estela de piedra)
	var estilo_panel := StyleBoxFlat.new()
	estilo_panel.bg_color = Color(0.12, 0.10, 0.08, 0.9) # Piedra oscura
	estilo_panel.border_color = Color(0.75, 0.60, 0.32, 0.9) # Borde dorado
	estilo_panel.set_border_width_all(3)
	estilo_panel.set_corner_radius_all(6)
	estilo_panel.content_margin_left = 20
	estilo_panel.content_margin_right = 20
	estilo_panel.content_margin_top = 20
	estilo_panel.content_margin_bottom = 20

	if panel_contenedor:
		panel_contenedor.add_theme_stylebox_override(\"panel\", estilo_panel)

	# 3. Estilos de los Botones (Normal, Hover/Enfoque y Presionado)
	var estilo_btn_normal := StyleBoxFlat.new()
	estilo_btn_normal.bg_color = Color(0.18, 0.15, 0.12, 0.8)
	estilo_btn_normal.border_color = Color(0.60, 0.48, 0.25, 0.7)
	estilo_btn_normal.set_border_width_all(2)
	estilo_btn_normal.set_corner_radius_all(4)
	estilo_btn_normal.content_margin_top = 8
	estilo_btn_normal.content_margin_bottom = 8

	var estilo_btn_hover := estilo_btn_normal.duplicate() as StyleBoxFlat
	estilo_btn_hover.bg_color = Color(0.35, 0.28, 0.15, 0.9) # Iluminación dorada
	estilo_btn_hover.border_color = Color(1.0, 0.88, 0.45, 1.0) # Borde brillante

	var estilo_btn_pressed := estilo_btn_hover.duplicate() as StyleBoxFlat
	estilo_btn_pressed.bg_color = Color(0.50, 0.40, 0.18, 1.0)

	var lista_botones = [boton_continuar, boton_reiniciar, boton_salir]

	for btn in lista_botones:
		if btn:
			btn.add_theme_stylebox_override(\"normal\", estilo_btn_normal)
			btn.add_theme_stylebox_override(\"hover\", estilo_btn_hover)
			btn.add_theme_stylebox_override(\"pressed\", estilo_btn_pressed)
			btn.add_theme_stylebox_override(\"focus\", estilo_btn_hover)

			# Colores de texto estilo piedra / arena
			btn.add_theme_color_override(\"font_color\", Color(0.92, 0.86, 0.73))
			btn.add_theme_color_override(\"font_hover_color\", Color(1.0, 0.96, 0.70))
			btn.add_theme_color_override(\"font_pressed_color\", Color(1.0, 1.0, 1.0))

# --- Funciones de interacción ---

func _on_continuar_pressed() -> void:
	get_tree().paused = false
	queue_free()

func _on_reinciar_pressed() -> void:
	print(\"reiniciando...\")
	get_tree().paused = false
	get_tree().reload_current_scene()

func _on_guardar_y_salir_pressed() -> void:
	get_tree().paused = false
	get_tree().change_scene_to_file(\"res://interfaz/menus/menu_principal.tscn\")

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"pausa\"):
		_on_continuar_pressed()
"

